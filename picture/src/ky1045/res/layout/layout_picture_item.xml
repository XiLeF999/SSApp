<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="256px"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="256px"
        android:layout_height="144px">

        <ImageView
            android:id="@+id/iv_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/view_selected_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_picture_selected_overlay"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10px"
            android:layout_marginEnd="10px"
            android:src="@drawable/img_pic_set_ic_d" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="@dimen/picture_name_height"
        android:gravity="center"
        android:paddingStart="12px"
        android:paddingEnd="12px"
        android:ellipsize="middle"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

</LinearLayout>