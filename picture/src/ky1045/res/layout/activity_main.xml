<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_background"
    android:orientation="vertical"
    android:paddingTop="@dimen/padding_top"
    android:paddingBottom="@dimen/padding_bottom">



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/title"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/ll_menu"
            android:layout_width="362px"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:translationY="-13px"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_all_picture"
                android:layout_width="match_parent"
                android:layout_height="95px"
                android:background="@drawable/selector_type_bg_select"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:text="全部图片"
                android:textColor="@color/selector_text_select"
                android:textSize="34px"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sd_picture"
                android:layout_width="match_parent"
                android:layout_height="95px"
                android:background="@drawable/selector_type_bg_select"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:text="TF图片"
                android:textColor="@color/selector_text_select"
                android:textSize="28px" />

            <TextView
                android:id="@+id/tv_usb_picture"
                android:layout_width="match_parent"
                android:layout_height="95px"
                android:background="@drawable/selector_type_bg_select"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:text="U盘图片"
                android:textColor="@color/selector_text_select"
                android:textSize="28px" />

            <TextView
                android:id="@+id/tv_local_picture"
                android:layout_width="match_parent"
                android:layout_height="95px"
                android:background="@drawable/selector_type_bg_select"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:text="本地图片"
                android:textColor="@color/selector_text_select"
                android:textSize="28px" />

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_folder_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="50px"
            android:layout_marginStart="@dimen/picture_list_margin_start"
            android:layout_marginEnd="@dimen/picture_list_margin_end"
            android:fadeScrollbars="false"
            android:orientation="vertical"
            android:overScrollMode="never" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="15px"
            android:layout_marginStart="@dimen/picture_list_margin_start"
            android:layout_marginEnd="@dimen/picture_list_margin_end"
            android:scrollbarFadeDuration="0"
            android:scrollbarSize="8px"
            android:scrollbarStyle="outsideInset"
            android:paddingRight="20px"
            android:scrollbarThumbVertical="@drawable/thumb_drawable"
            android:scrollbarTrackVertical="@drawable/track_drawable"
            android:scrollbars="vertical"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/view_scrollbar_area"
            android:layout_width="@dimen/picture_scrollbar_area_width"
            android:layout_height="match_parent"
            android:layout_marginTop="50px">

            <View
                android:id="@+id/view_scrollbar_track"
                android:layout_width="8px"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/track_drawable" />

            <View
                android:id="@+id/view_scrollbar_thumb"
                android:layout_width="8px"
                android:layout_height="36px"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/thumb_drawable" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/view_empty"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingBottom="60px"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/img_pic_bg_no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:text="暂无相关内容"
                    android:textColor="@color/text_secondary"
                    android:textSize="20sp" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="60px"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="46px"
        android:fontFamily="@font/alibabapuhuiti_3_65_medium"
        android:text="图片"
        android:textColor="@color/text_secondary"
        android:textSize="30px" />
    <FrameLayout
        android:id="@+id/top_right"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24px"
        android:clipChildren="false">
        <TextView
            android:id="@+id/tv_select_num"
            android:layout_width="wrap_content"
            android:layout_height="48px"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:layout_marginStart="397px"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:background="@drawable/shape_select_count_bg"
            android:paddingLeft="20px"
            android:paddingRight="20px"
            android:textColor="@color/white"
            android:textSize="20px"
            android:text="已选择(0)"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_manager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="78px"
            android:background="@drawable/selector_manager_bg"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:gravity="center"
            android:paddingLeft="30px"
            android:paddingTop="5px"
            android:paddingRight="30px"
            android:paddingBottom="5px"
            android:text="管理"
            android:textColor="@color/selector_text_manager"
            android:textSize="28px"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/ll_manager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginRight="78px"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_all_select"
                android:layout_width="wrap_content"
                android:layout_height="48px"
                android:background="@drawable/selector_manager_bg"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:paddingLeft="30px"
                android:paddingTop="5px"
                android:paddingRight="30px"
                android:paddingBottom="5px"
                android:text="全选"
                android:textColor="@color/selector_text_manager"
                android:textSize="28px" />

            <TextView
                android:id="@+id/tv_delete"
                android:layout_width="wrap_content"
                android:layout_height="48px"
                android:layout_marginLeft="16px"
                android:background="@drawable/selector_manager_bg"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:paddingLeft="30px"
                android:paddingTop="5px"
                android:paddingRight="30px"
                android:paddingBottom="5px"
                android:text="删除"
                android:textColor="@color/selector_text_manager"
                android:textSize="28px" />

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="wrap_content"
                android:layout_height="48px"
                android:layout_marginLeft="16px"
                android:background="@drawable/shape_cancel_manager_bg"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:paddingLeft="30px"
                android:paddingTop="5px"
                android:paddingRight="30px"
                android:paddingBottom="5px"
                android:text="取消"
                android:textColor="@color/white"
                android:textSize="28px" />

        </LinearLayout>


    </FrameLayout>
</RelativeLayout>
