<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="80px"
    android:background="@color/color_ECF3FA">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80px" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="40px"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:textColor="@color/color_49535F"
            android:textSize="30sp"
            android:text="图片" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:layout_marginRight="80px"
            android:gravity="center"
            android:paddingLeft="30px"
            android:paddingRight="30px"
            android:paddingTop="5px"
            android:paddingBottom="5px"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:textColor="@color/color_8593A2"
            android:textSize="20sp"
            android:background="@drawable/shape_manager_bg"
            android:text="管理" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal" >

        <LinearLayout
            android:layout_width="400px"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_all_picture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="全部图片"
                android:textColor="@color/color_8593A2"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_usb_picture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="USB图片"
                android:textColor="@color/color_8593A2"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sd_picture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="SD图片"
                android:textColor="@color/color_8593A2"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_local_picture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="本地图片"
                android:textColor="@color/color_8593A2"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_folder_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:orientation="vertical"
            android:overScrollMode="never" />

        <com.sansan.picture.widget.ScrollableRecyclerView
            android:id="@+id/rv_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>