<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.jackandphantom.carouselrecyclerview.CarouselRecyclerview
        android:id="@+id/carouselRecyclerview"
        android:layout_width="1920px"
        android:layout_height="720px"
        android:layout_gravity="center"
        android:visibility="gone" />

    <com.sansan.picture.widget.PictureFrameLayout
        android:id="@+id/fl_picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" >

        <com.github.chrisbanes.photoview.PhotoView
            android:id="@+id/iv_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </com.sansan.picture.widget.PictureFrameLayout>

    <FrameLayout
        android:id="@+id/fl_picture_info"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" >

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/img_pic_ic_no"
            android:layout_gravity="top|end"
            android:layout_marginTop="48px"
            android:layout_marginRight="56px" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/shape_picture_info_bg"
            android:paddingTop="24px"
            android:paddingBottom="24px"
            android:paddingLeft="16px"
            android:paddingRight="16px" >

            <TextView
                android:id="@+id/tv_picture_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_picture_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="20sp" />




        </LinearLayout>



    </FrameLayout>




    


</FrameLayout>