<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@mipmap/img_background" >

    <LinearLayout
        android:layout_width="1296px"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90px"
            android:layout_marginStart="50px"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:text="收音机" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:gravity="bottom" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_49535F"
                android:textSize="20sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="FM" />

            <TextView
                android:id="@+id/tv_frequency"
                android:layout_width="240px"
                android:layout_height="wrap_content"
                android:layout_marginStart="16px"
                android:layout_marginEnd="16px"
                android:gravity="center"
                android:textColor="@color/black"
                android:textSize="58sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:text="92.8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_8593A2"
                android:textSize="20sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="MHz" />

        </LinearLayout>
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="1104px"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" >

            <ImageView
                android:id="@+id/iv_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/selector_radio_btn_sub"/>

            <ImageView
                android:id="@+id/iv_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/selector_radio_btn_add"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.sansan.radio.widget.RadioScaleView
            android:id="@+id/view_radio_scale"
            android:layout_width="1154px"
            android:layout_height="120px"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10px" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical" >

            <ImageView
                android:id="@+id/iv_fav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/selector_radio_btn_fav"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="80px"
                android:src="@drawable/selector_radio_previous"/>

            <RelativeLayout
                android:id="@+id/re_play"
                android:layout_width="80px"
                android:layout_height="80px"
                android:layout_marginLeft="80px"
                android:layout_marginRight="80px"
                android:background="@mipmap/img_radio_play_bg" >

                <ImageView
                    android:id="@+id/iv_play"
                    android:layout_width="64px"
                    android:layout_height="64px"
                    android:layout_centerInParent="true"
                    android:src="@drawable/selector_radio_play" />

            </RelativeLayout>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="80px"
                android:src="@drawable/selector_radio_next"/>

            <ImageView
                android:id="@+id/iv_search"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/selector_radio_btn_search"/>


        </LinearLayout>


    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/img_radio_side_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="100px" >

                <TextView
                    android:id="@+id/tv_fm_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/selector_radio_type"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:drawableBottom="@drawable/selector_radio_type_bar"
                    android:text="FM列表" />

                <View
                    android:layout_width="2px"
                    android:layout_height="26px"
                    android:layout_marginLeft="60px"
                    android:layout_gravity="center_vertical"
                    android:background="@color/color_C5DBF2" />

                <TextView
                    android:id="@+id/tv_fav_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="60px"
                    android:textColor="@color/selector_radio_type"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:drawableBottom="@drawable/selector_radio_type_bar"
                    android:text="收藏列表" />

            </LinearLayout>

            <!-- Fragment容器 -->
            <FrameLayout
                android:id="@+id/fragment_radio"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />


        </LinearLayout>

    </FrameLayout>






</LinearLayout>