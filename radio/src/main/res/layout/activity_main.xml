<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="1296px"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="90px"
            android:layout_marginStart="50px"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:text="收音机" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:gravity="bottom" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/color_49535F"
                android:textSize="18sp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="FM" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10px"
                android:textColor="@color/black"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="92.8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10px"
                android:textColor="@color/color_8593A2"
                android:textSize="18sp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="MHz" />

        </LinearLayout>
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="1000px"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" >

            <ImageView
                android:layout_width="50px"
                android:layout_height="50px"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@mipmap/ic_launcher"/>

            <ImageView
                android:layout_width="50px"
                android:layout_height="50px"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@mipmap/ic_launcher"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.sansan.radio.widget.RadioScaleView
            android:id="@+id/view_radio_scale"
            android:layout_width="1000px"
            android:layout_height="200px"
            android:layout_gravity="center_horizontal"
            android:background="@color/color_C5DBF2"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical" >

            <Button
                android:id="@+id/bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="扫描"/>


        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/color_C5DBF2" >



    </LinearLayout>




</LinearLayout>