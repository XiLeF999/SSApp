<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="880px"
    android:layout_height="296px"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@mipmap/img_bg_dialog">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/alibabapuhuiti_3_65_medium"
        android:text="退出收音机?"
        android:layout_marginTop="40px"
        android:textColor="@color/color_49535F"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_marginTop="45px"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_sure"
            android:layout_width="180px"
            android:layout_height="80px"
            android:background="@mipmap/img_pic_sel_1"
            android:gravity="center"
            android:text="确定"
            android:textColor="@color/white"
            android:textSize="20sp" />


        <TextView
            android:id="@+id/tv_go_back"
            android:layout_width="180px"
            android:layout_height="80px"
            android:layout_marginLeft="100px"
            android:background="@mipmap/img_pic_sel_2"
            android:gravity="center"
            android:text="进入后台"
            android:textColor="@color/white"
            android:textSize="20sp" />

    </LinearLayout>

</LinearLayout>