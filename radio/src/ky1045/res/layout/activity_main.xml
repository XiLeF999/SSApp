<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/img_background"
    android:paddingBottom="@dimen/padding_bottom">

    <LinearLayout
        android:layout_width="744px"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="84px"
            android:layout_marginStart="46px"
            android:textColor="@color/black"
            android:textSize="32px"
            android:textStyle="bold"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:text="收音机" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_marginTop="-23px"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="32px"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                app:layout_constraintEnd_toStartOf="@id/tv_frequency"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_frequency"
                android:layout_marginEnd="20px"
                android:text="FM" />

            <TextView
                android:id="@+id/tv_frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:textColor="@color/black"
                android:textSize="81px"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:text="92.8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#92A7BF"
                android:textSize="32px"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                app:layout_constraintStart_toEndOf="@id/tv_frequency"
                app:layout_constraintBaseline_toBaselineOf="@id/tv_frequency"
                android:layout_marginStart="16px"
                android:text="MHz" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="166px"
            android:layout_marginHorizontal="24px"
            android:layout_marginTop="18px"
            android:layout_gravity="center_horizontal" >

            <com.sansan.radio.widget.RadioScaleView
                android:id="@+id/view_radio_scale"
                android:layout_width="504px"
                android:layout_height="118px"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_search_decor_left"
                android:layout_marginTop="20px" />

            <ImageView
                android:id="@+id/iv_sub"
                android:layout_width="76px"
                android:layout_height="76px"
                android:layout_marginTop="10px"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/view_radio_scale"
                android:src="@drawable/selector_radio_btn_sub"/>

            <TextView
                android:id="@+id/tv_scan_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone"
                android:textColor="#5A6876"
                android:textSize="26px"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium" />

            <ImageView
                android:id="@+id/iv_search_decor_left"
                android:layout_width="162px"
                android:layout_height="32px"
                android:src="@drawable/radio_decor_l_bg_off"
                app:layout_constraintStart_toStartOf="@id/view_radio_scale"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_search_decor_right"
                android:layout_width="162px"
                android:layout_height="32px"
                android:src="@drawable/radio_decor_r_bg_off"
                app:layout_constraintEnd_toEndOf="@id/view_radio_scale"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_add"
                android:layout_width="76px"
                android:layout_height="76px"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/view_radio_scale"
                android:layout_marginTop="15px"
                android:src="@drawable/selector_radio_btn_add"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:layout_marginTop="5px"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical" >

            <ImageView
                android:id="@+id/iv_fav"
                android:layout_width="56px"
                android:layout_height="56px"
                app:layout_constraintTop_toTopOf="@id/re_play"
                app:layout_constraintBottom_toBottomOf="@id/re_play"
                android:layout_marginEnd="58px"
                app:layout_constraintEnd_toStartOf="@id/iv_previous"
                android:src="@drawable/selector_radio_btn_fav"/>

            <ImageView
                android:id="@+id/iv_previous"
                android:layout_width="56px"
                android:layout_height="56px"
                android:layout_marginEnd="50px"
                app:layout_constraintTop_toTopOf="@id/re_play"
                app:layout_constraintBottom_toBottomOf="@id/re_play"
                app:layout_constraintEnd_toStartOf="@id/re_play"
                android:src="@drawable/selector_radio_previous"/>

            <RelativeLayout
                android:id="@+id/re_play"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="80px"
                android:layout_height="80px"
                android:background="@drawable/img_radio_play_bg" >

                <ImageView
                    android:id="@+id/iv_play"
                    android:layout_width="64px"
                    android:layout_height="64px"
                    android:layout_centerInParent="true"
                    android:src="@drawable/selector_radio_play" />

            </RelativeLayout>

            <ImageView
                android:id="@+id/iv_next"
                android:layout_width="56px"
                android:layout_height="56px"
               android:layout_marginStart="50px"
                app:layout_constraintTop_toTopOf="@id/re_play"
                app:layout_constraintBottom_toBottomOf="@id/re_play"
                app:layout_constraintStart_toEndOf="@id/re_play"
                android:src="@drawable/selector_radio_next"/>

            <ImageView
                android:id="@+id/iv_search"
                android:layout_width="56px"
                android:layout_height="56px"
                android:layout_marginStart="58px"
                app:layout_constraintTop_toTopOf="@id/re_play"
                app:layout_constraintBottom_toBottomOf="@id/re_play"
                app:layout_constraintStart_toEndOf="@id/iv_next"
                android:src="@drawable/selector_radio_btn_search"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_side"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/radio_side_bg">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_radio_side_bg"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" >

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="start"
                android:layout_marginStart="48px"
                android:gravity="center_vertical"
                android:layout_marginTop="84px" >

                <TextView
                    android:id="@+id/tv_fm_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/selector_radio_type"
                    android:textSize="32px"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:drawableBottom="@drawable/selector_radio_type_bar"
                    android:text="FM列表" />

                <View
                    android:layout_width="2px"
                    android:layout_height="26px"
                    android:layout_marginLeft="60px"
                    android:layout_gravity="center_vertical"
                    android:background="@color/_7" />

                <TextView
                    android:id="@+id/tv_fav_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="60px"
                    android:textColor="@color/selector_radio_type"
                    android:textSize="32px"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:drawableBottom="@drawable/selector_radio_type_bar"
                    android:text="收藏列表" />

            </LinearLayout>

            <!-- Fragment容器 -->
            <FrameLayout
                android:id="@+id/fragment_radio"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />


        </LinearLayout>

    </FrameLayout>






</LinearLayout>
