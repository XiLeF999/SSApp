<?xml version="1.0" encoding="utf-8"?>
<com.sansan.video.widget.VideoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fl_video"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 视频播放器视图 -->
    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/fl_video_controller"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <LinearLayout
            android:id="@+id/ll_video_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/shape_video_info_bg"
            android:layout_marginTop="110px"
            android:layout_marginLeft="45px"
            android:padding="16px"
            android:visibility="gone" >

            <TextView
                android:id="@+id/tv_video_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_video_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_video_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_video_resolution"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_video_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_video_path"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:textColor="@color/white"
                android:textSize="20sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_video_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_pic_ic_system_prompt"
            android:layout_gravity="top|start"
            android:layout_marginTop="56px"
            android:layout_marginLeft="56px" />

        <ImageView
            android:id="@+id/iv_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/img_pic_ic_play" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_pic_ic_no"
            android:layout_gravity="top|end"
            android:layout_marginTop="56px"
            android:layout_marginRight="56px" />

        <FrameLayout
            android:id="@+id/custom_controls"
            android:layout_width="match_parent"
            android:layout_height="100px"
            android:layout_gravity="bottom" >

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:progress="50"
                android:progressDrawable="@drawable/video_seekbar_track"
                android:thumb="@drawable/video_seekbar_thumb"
                android:thumbOffset="0px" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginLeft="24px"
                android:layout_marginTop="6px"
                android:layout_gravity="top|left" >

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:textColor="@color/white"
                    android:text="00:00"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:text="/"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:textColor="@color/white"
                    android:text="00:00"
                    android:textSize="14sp" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="100px"
            android:layout_height="50px"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:layout_marginRight="24px"
            android:layout_marginBottom="56px"
            android:layout_gravity="bottom|right"
            android:gravity="center"
            android:text="1.0倍"
            android:textColor="@color/white"
            android:textSize="18sp" />

    </FrameLayout>

</com.sansan.video.widget.VideoFrameLayout>