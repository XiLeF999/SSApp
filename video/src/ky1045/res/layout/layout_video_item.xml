<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="256px" android:layout_height="wrap_content" android:orientation="vertical">
    <FrameLayout android:layout_width="256px" android:layout_height="144px">
        <ImageView android:id="@+id/iv_picture" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
        <View android:id="@+id/view_selected_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/shape_video_selected_overlay" android:visibility="gone" />
        <ImageView android:id="@+id/iv_select" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_marginTop="10px" android:layout_marginEnd="10px" android:src="@drawable/img_pic_set_ic_d" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="32px" android:layout_gravity="bottom">
            <TextView android:id="@+id/tv_duration" android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_marginStart="8px" android:gravity="center" android:textColor="@color/white" android:textSize="14sp" />
            <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical|end" android:layout_marginEnd="8px" android:src="@drawable/img_pic_set_ic_play" />
        </FrameLayout>
    </FrameLayout>
    <TextView android:id="@+id/tv_name" android:layout_width="match_parent" android:layout_height="@dimen/video_name_height" android:ellipsize="middle" android:gravity="center" android:singleLine="true" android:textColor="@color/text_primary" android:textSize="16sp" />
</LinearLayout>
