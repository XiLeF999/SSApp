<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="600px"
    android:layout_height="340px"
    android:background="@drawable/shape_delete_dialog_bg">

    <LinearLayout
        android:id="@+id/ll_delete"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="90px"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:gravity="center"
            android:text="删除"
            android:textColor="@color/delete_dialog_title"
            android:textSize="40px"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="110px"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:gravity="center"
            android:text="确定删除文件?"
            android:textColor="@color/delete_dialog_message"
            android:textSize="32px" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="140px"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingTop="16px">

            <TextView
                android:id="@+id/tv_sure"
                android:layout_width="180px"
                android:layout_height="80px"
                android:background="@drawable/img_pic_sel_1"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:text="确定"
                android:textColor="@color/white"
                android:textSize="28px" />

            <TextView
                android:id="@+id/tv_cancel"
                android:layout_width="180px"
                android:layout_height="80px"
                android:layout_marginStart="40px"
                android:background="@drawable/shape_delete_cancel_bg"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:gravity="center"
                android:text="取消"
                android:textColor="@color/delete_dialog_cancel_text"
                android:textSize="28px" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fl_delete_progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.sansan.video.widget.RotateImageView
                android:id="@+id/iv_progress"
                android:layout_width="120px"
                android:layout_height="120px"
                android:src="@drawable/img_executing" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25px"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="删除中……"
                android:textColor="@color/delete_dialog_message"
                android:textSize="28px" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/fl_delete_success"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="120px"
                android:layout_height="120px"
                android:src="@drawable/img_executed" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25px"
                android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                android:text="删除成功!"
                android:textColor="@color/delete_dialog_message"
                android:textSize="28px" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
