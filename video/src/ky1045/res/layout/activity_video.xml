<?xml version="1.0" encoding="utf-8"?>
<com.sansan.video.widget.VideoFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_video"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.google.android.exoplayer2.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <FrameLayout
        android:id="@+id/fl_video_controller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="48px"
            android:layout_height="48px"
            android:layout_gravity="top|start"
            android:layout_marginStart="16px"
            android:layout_marginTop="16px"
            android:scaleType="centerInside"
            android:src="@drawable/img_pic_ic_back" />

        <ImageView
            android:id="@+id/iv_video_info"
            android:layout_width="36px"
            android:layout_height="36px"
            android:layout_gravity="top|start"
            android:layout_marginStart="16px"
            android:layout_marginTop="92px"
            android:scaleType="centerInside"
            android:src="@drawable/img_pic_ic_system_prompt" />

        <LinearLayout
            android:id="@+id/ll_video_info"
            android:layout_width="288px"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="60px"
            android:layout_marginTop="80px"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="196px"
                android:layout_height="68px"
                android:background="@drawable/shape_video_info_bg"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8px"
                android:paddingEnd="8px">

                <TextView
                    android:id="@+id/tv_video_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="24px" />

                <TextView
                    android:id="@+id/tv_video_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alibabapuhuiti_3_65_medium"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="20px" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="288px"
                android:layout_height="168px"
                android:layout_marginTop="4px"
                android:background="@drawable/shape_video_info_bg"
                android:orientation="vertical"
                android:paddingStart="16px"
                android:paddingTop="12px"
                android:paddingEnd="16px"
                android:paddingBottom="12px">

                <TextView android:id="@+id/tv_video_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="middle" android:fontFamily="@font/alibabapuhuiti_3_65_medium" android:singleLine="true" android:textColor="@color/white" android:textSize="20px" />
                <TextView android:id="@+id/tv_video_resolution" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/alibabapuhuiti_3_65_medium" android:singleLine="true" android:textColor="@color/white" android:textSize="20px" />
                <TextView android:id="@+id/tv_video_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/alibabapuhuiti_3_65_medium" android:singleLine="true" android:textColor="@color/white" android:textSize="20px" />
                <TextView android:id="@+id/tv_video_path" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:fontFamily="@font/alibabapuhuiti_3_65_medium" android:maxLines="2" android:textColor="@color/white" android:textSize="20px" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_play_pause"
            android:layout_width="96px"
            android:layout_height="96px"
            android:layout_gravity="center"
            android:scaleType="centerInside"
            android:src="@drawable/img_pic_ic_play" />

        <FrameLayout
            android:id="@+id/custom_controls"
            android:layout_width="match_parent"
            android:layout_height="112px"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40px"
                android:layout_marginStart="16px"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView android:id="@+id/tv_current_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alibabapuhuiti_3_65_medium" android:text="00:00" android:textColor="@color/white" android:textSize="20px" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="/" android:textColor="@color/white" android:textSize="20px" />
                <TextView android:id="@+id/tv_total_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/alibabapuhuiti_3_65_medium" android:text="00:00" android:textColor="@color/white" android:textSize="20px" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="48px"
                android:layout_gravity="bottom"
                android:layout_marginBottom="22px"
                android:maxHeight="12px"
                android:minHeight="12px"
                android:progressDrawable="@drawable/video_seekbar_track"
                android:thumb="@drawable/video_seekbar_thumb"
                android:thumbOffset="0px" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_speed"
            android:layout_width="100px"
            android:layout_height="50px"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="24px"
            android:layout_marginBottom="60px"
            android:fontFamily="@font/alibabapuhuiti_3_65_medium"
            android:gravity="center"
            android:text="1.0倍"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </FrameLayout>
</com.sansan.video.widget.VideoFrameLayout>


